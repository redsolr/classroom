{
  "name": "class-room",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "predev": "node scripts/ensure-dev-port.mjs",
    "dev": "cross-env NODE_OPTIONS=--max-http-header-size=65536 next dev --turbopack -p 3020",
    "predev:mock": "node scripts/ensure-dev-port.mjs",
    "dev:mock": "cross-env MOCK_AUTH=true NODE_OPTIONS=--max-http-header-size=65536 next dev --turbopack -p 3020",
    "build": "next build",
    "vercel-build": "node scripts/migrate-deploy.mjs && npx tsx scripts/seed-packs.ts && npx tsx scripts/seed-paths.ts && next build",
    "start": "next start -p 3020",
    "lint": "eslint src --cache --cache-location node_modules/.cache/eslint/ --cache-strategy content",
    "lint:fix": "eslint src --fix --cache --cache-location node_modules/.cache/eslint/ --cache-strategy content",
    "tsc:check": "tsc --noEmit",
    "check:actions": "node scripts/check-action-auth.mjs",
    "verify": "npm run lint && npm run tsc:check && npm run check:actions",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "db:seed": "tsx --env-file=.env.local scripts/seed.ts",
    "db:seed:study": "tsx --env-file=.env.local scripts/seed-study.ts",
    "db:seed:packs": "tsx --env-file=.env.local scripts/seed-packs.ts",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "test:e2e": "playwright test",
    "test:e2e:real-auth": "cross-env E2E_MODE=real-auth playwright test",
    "e2e:user": "tsx --env-file=.env.local scripts/e2e-workos-user.ts",
    "db:seed:paths": "tsx --env-file=.env.local scripts/seed-paths.ts",
    "db:seed:tutors": "tsx --env-file=.env.local scripts/seed-tutors.ts",
    "db:seed:call": "tsx --env-file=.env.local scripts/seed-call.ts",
    "test:e2e:live-call": "cross-env E2E_MODE=live-call playwright test"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.111.0",
    "@cloudflare/realtimekit": "^2.0.2",
    "@date-fns/tz": "^1.5.0",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-tabs": "^1.1.13",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@workos-inc/authkit-nextjs": "^3.0.0",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "drizzle-orm": "^0.44.0",
    "lucide-react": "^1.17.0",
    "mcp-handler": "^2.1.1",
    "next": "^16.2.10",
    "openai": "^7.4.0",
    "postgres": "^3.4.7",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "sonner": "^2.0.8",
    "stripe": "^22.4.0",
    "tailwind-merge": "^3.5.0",
    "web-push": "^3.6.7",
    "zod": "^4.3.6",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/web-push": "^3.6.4",
    "cross-env": "^10.1.0",
    "drizzle-kit": "^0.31.0",
    "eslint": "^10",
    "eslint-config-next": "^16.2.10",
    "eslint-plugin-react-hooks": "^7.1.1",
    "tailwindcss": "^4",
    "tsx": "^4.20.0",
    "typescript": "^5",
    "typescript-eslint": "^8.63.0"
  }
}
