# --- Database ---------------------------------------------------------------
# Local dev: docker compose up -d (postgres on 5439 — 5432/5433 are taken by
# the platform container and a native Windows PostgreSQL service)
DATABASE_URL=postgresql://classroom:classroom@localhost:5439/classroom

# --- Auth (WorkOS AuthKit) ----------------------------------------------------
# Leave these empty and run `npm run dev:mock` to develop without WorkOS keys.
WORKOS_API_KEY=
WORKOS_CLIENT_ID=
WORKOS_COOKIE_PASSWORD= # openssl rand -base64 32 — must be 32+ chars
# Distinct cookie name — localhost cookies are shared across ports, and the
# other Jurisimus apps (web-app :3000, crm-web :3100) use the default
# 'wos-session' with a DIFFERENT cookie password. Without this, signing into
# any sibling app clobbers the class-room session (constant surprise logouts
# + /auth/refresh -> /login churn).
WORKOS_COOKIE_NAME=classroom-wos-session
NEXT_PUBLIC_WORKOS_REDIRECT_URI=http://localhost:3020/callback

# --- AI ----------------------------------------------------------------------
# Leave empty to use the deterministic mock extractor (no paid calls).
ANTHROPIC_API_KEY=

# Self-study tutor (/study) runs on OpenAI, and so does lesson-audio
# transcription (a recorded call becomes text once its audio is ours).
# Leave empty for the offline mock tutor (free — used by dev and e2e);
# recordings then wait at `ingested` with the reason on the row and are
# picked up by the daily sweep once the key exists — never transcribed
# to silence.
OPENAI_API_KEY=
# Must be a model that returns timed segments (`diarized_json`): the
# plain gpt-4o-transcribe family returns text only, and a lesson needs
# times to lay two people's separately transcribed voices on one clock.
# CLASSROOM_TRANSCRIBE_MODEL=gpt-4o-transcribe-diarize
# STUDY_AI_MODELS=gpt-5.6-terra,gpt-5.6-sol,gpt-5.6-luna  # composer roster
# STUDY_AI_MODEL=gpt-5.6-terra          # preselected default (roster member)
# STUDY_FREE_DAILY_CAP=10               # free-tier tutor messages / 24h
# STUDY_PRO_DAILY_CAP=500               # pro abuse brake / 24h

# --- Billing (Stripe — self-study subscription only) --------------------------
# All three or none: with any missing, /study/account says "billing not
# configured" and the free tier applies. Use test-mode keys locally; the
# webhook needs `stripe listen --forward-to localhost:3020/api/stripe/webhook`.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_STUDY_PRICE_ID=

# --- Tutor marketplace (Stripe Connect) ---------------------------------------
# Uses STRIPE_SECRET_KEY above — no separate key. Tutors onboard to their own
# Express accounts; a lesson is a destination charge with our cut taken as an
# application fee. Enable these events on the webhook endpoint, INCLUDING the
# Connect one: checkout.session.completed, payment_intent.succeeded,
# invoice.paid, customer.subscription.*, charge.refunded, account.updated.
#
# With STRIPE_SECRET_KEY empty, bookings are off entirely and both sides say so
# — a learner must never be able to pay for a lesson we can't pay a tutor for.
#
# Our commission, as a percentage of what the learner pays. Stamped onto every
# payment row when it's taken, so changing it never rewrites history.
# TUTOR_PLATFORM_FEE_PERCENT=15
# What a standing weekly slot saves against booking the same lessons one at a
# time. Stamped onto the subscription at signup, for the same reason.
# TUTOR_RECURRING_DISCOUNT_PERCENT=10
#
# Stripe's published rate, used ONLY to estimate OUR OWN take before the balance
# transaction lands. Never used to compute what a tutor receives — their number
# is exact because we absorb processing out of our share (lib/tutor-pricing.ts).
# STRIPE_FEE_PERCENT=2.9
# STRIPE_FEE_FIXED_CENTS=30

# --- App ---------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3020

# --- Live lessons (Cloudflare RealtimeKit) ---------------------------------
# App-scoped Basic credential, NOT a Cloudflare account API token: it can
# only reach this one RealtimeKit app, so a leak cannot touch R2 or Workers.
# Both come from creating the app (POST /accounts/<id>/realtime/kit/apps);
# the API key is the app's `access_token`. Without them the lesson room says
# so plainly instead of failing at join time.
REALTIMEKIT_APP_ID=
REALTIMEKIT_API_KEY=

# --- Agent door (MCP) ------------------------------------------------------
# `POST /mcp` lets an agent run the teacher's roster operations without a
# browser session — list/create students, schedule a lesson, get its call
# room. Closed unless BOTH are set: the token proves the caller, the
# allowlist says which teachers it may act as. An unset allowlist refuses
# every call rather than defaulting to "any teacher".
CLASSROOM_MCP_TOKEN=
CLASSROOM_MCP_TEACHER_EMAILS=

# --- Message notifications (web push) --------------------------------------
# Generate once: `npx web-push generate-vapid-keys` → the pair goes here and
# into Vercel. With either unset, push is OFF: /api/push/vapid-key answers
# null, the "Notify me" button never renders, and messages fall back to the
# in-app unread badge. The subject is how a push service reaches the sender
# about misbehaving delivery.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:admin@jurisimus.com

# --- Lesson audio storage (Cloudflare R2) -----------------------------------
# Where a recorded lesson LIVES once it is ours. RealtimeKit keeps its own
# copy behind presigned URLs that expire after SEVEN DAYS, so until these are
# set every recorded lesson is on a countdown and nothing downstream
# (transcription, learning artifacts) may start. Unset is not silent: the
# recording row says, in its own failure_reason, that it could not be copied.
#
# R2 speaks the S3 API — there is no AWS account involved. Create the bucket
# and an R2 API token scoped to THAT BUCKET ONLY (Cloudflare dashboard -> R2
# -> Manage API tokens), so a leaked key cannot reach the rest of the account.
R2_ACCOUNT_ID=
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# Point at any S3-compatible store instead (a local MinIO, say) to exercise
# the whole copy path without spending real writes.
# R2_ENDPOINT=http://localhost:9000

# --- The lesson-audio safety net --------------------------------------------
# GET /api/calls/reconcile picks up every recording that finished and is not
# in our bucket yet — including ones whose webhook never arrived — and shouts
# about any whose provider copy expires within 48 hours; then it carries every
# recording that IS ours through transcription and drafting to the teacher's
# desk. Vercel's cron calls it daily (06:00 Bangkok; the Hobby scope allows no
# more) and sends this bearer automatically once
# the variable exists.
# Unset => the endpoint is closed (503), which is also the state in which
# nothing sweeps at all.
CRON_SECRET=
