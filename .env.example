# --- Database ---------------------------------------------------------------
# Local dev: docker compose up -d (postgres on 5439 — 5432/5433 are taken by
# the platform container and a native Windows PostgreSQL service)
DATABASE_URL=postgresql://classroom:classroom@localhost:5439/classroom

# --- Auth (WorkOS AuthKit) ----------------------------------------------------
# Leave these empty and run `npm run dev:mock` to develop without WorkOS keys.
WORKOS_API_KEY=
WORKOS_CLIENT_ID=
WORKOS_COOKIE_PASSWORD= # openssl rand -base64 32 — must be 32+ chars
# Distinct cookie name — localhost cookies are shared across ports, and the
# other Jurisimus apps (web-app :3000, crm-web :3100) use the default
# 'wos-session' with a DIFFERENT cookie password. Without this, signing into
# any sibling app clobbers the class-room session (constant surprise logouts
# + /auth/refresh -> /login churn).
WORKOS_COOKIE_NAME=classroom-wos-session
NEXT_PUBLIC_WORKOS_REDIRECT_URI=http://localhost:3020/callback

# --- AI ----------------------------------------------------------------------
# Leave empty to use the deterministic mock extractor (no paid calls).
ANTHROPIC_API_KEY=

# Self-study tutor (/study) runs on OpenAI. Leave empty for the offline
# mock tutor (free — used by dev and e2e).
OPENAI_API_KEY=
# STUDY_AI_MODELS=gpt-5.6-terra,gpt-5.6-sol,gpt-5.6-luna  # composer roster
# STUDY_AI_MODEL=gpt-5.6-terra          # preselected default (roster member)
# STUDY_FREE_DAILY_CAP=10               # free-tier tutor messages / 24h
# STUDY_PRO_DAILY_CAP=500               # pro abuse brake / 24h

# --- Billing (Stripe — self-study subscription only) --------------------------
# All three or none: with any missing, /study/account says "billing not
# configured" and the free tier applies. Use test-mode keys locally; the
# webhook needs `stripe listen --forward-to localhost:3020/api/stripe/webhook`.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_STUDY_PRICE_ID=

# --- App ---------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3020
